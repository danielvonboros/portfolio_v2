ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Den Pfad für Weiterleitungen aus THE_REQUEST nehmen, nicht aus REQUEST_URI:
  # all-inkl hat MultiViews aktiv, das /seite schon vor diesen Regeln auf
  # /seite.html umschreibt. Sonst landet die Weiterleitung auf der .html-Adresse.
  # Nur der Pfad ohne ?Query: Den Query-String hängt Apache selbst wieder an.

  # www auf die Hauptdomain umleiten: eine Adresse pro Seite, kein Duplicate Content.
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteCond %{THE_REQUEST} ^\S+\s(/[^\s?]*)
  RewriteRule ^ https://danielvonboros.com%1 [NE,L,R=301]

  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteCond %{THE_REQUEST} ^\S+\s(/[^\s?]*)
  RewriteRule ^ https://%{HTTP_HOST}%1 [NE,L,R=301]

  # Projektadressen bis Version 2.0.0 hatten Bindestriche, seit 3.0.0 folgen
  # sie der Domain des Projekts. Die alten Adressen leiten dauerhaft um.
  RewriteCond %{THE_REQUEST} ^\S+\s/(projekte|en/projects)/denison-silva(?:\.html)?[\s?]
  RewriteRule ^ https://danielvonboros.com/%1/denisonsilva [NE,L,R=301]

  RewriteCond %{THE_REQUEST} ^\S+\s/(projekte|en/projects)/studio-von-boros(?:\.html)?[\s?]
  RewriteRule ^ https://danielvonboros.com/%1/studiovonboros [NE,L,R=301]

  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Vorgerenderte Seiten: /impressum liefert impressum.html aus.
  # Alles andere fällt durch auf ErrorDocument und bekommt einen echten 404.
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+)$ $1.html [L]
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml font/woff2
</IfModule>

# Header gehoert zu mod_headers, nicht zu mod_expires.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2|woff|ttf|otf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(jpg|jpeg|png|webp|avif|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
